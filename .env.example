# NestJS API (APP_PORT=3001, API_PREFIX=backend, URI version v1)
NEXT_PUBLIC_API_URL=http://localhost:3001/backend/v1

# This Next.js app — always port 3000
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In (must match backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Swagger UI on the backend
NEXT_PUBLIC_API_DOCS_URL=http://localhost:3001/docs

# Vero Browser / Android downloads (empty = Coming soon on /download)
NEXT_PUBLIC_DOWNLOAD_VERSION=1.0.0
NEXT_PUBLIC_DOWNLOAD_RELEASE_DATE=2026-09-21
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_WINDOWS_SIZE=~113 MB
NEXT_PUBLIC_DOWNLOAD_WINDOWS_SHA512=
NEXT_PUBLIC_DOWNLOAD_ANDROID=
NEXT_PUBLIC_DOWNLOAD_ANDROID_SIZE=
NEXT_PUBLIC_DOWNLOAD_ANDROID_SHA512=
