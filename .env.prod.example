# =============================================================================
# Virwo Frontend — Production Deployment Environment Configuration
# Copy this to /var/www/virwo/frontend/.env on the VPS server.
# =============================================================================

# Image tag managed automatically by GitHub Actions CI/CD
DOCKER_IMAGE=ghcr.io/minilikbelachew/chromium-frontend:production

NODE_ENV=production
FRONTEND_PORT=3090
PORT=3000

# API base URL for client requests (can be a subpath or subdomain)
NEXT_PUBLIC_API_URL=http://virwo.learnica.net/backend
